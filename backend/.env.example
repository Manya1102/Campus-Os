PORT=5001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_SUPABASE_DB_HOST:5432/postgres
DATABASE_SSL=require
DB_POOL_SIZE=10
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-rotated-server-only-secret-key
SUPABASE_STORAGE_BUCKET=campus-resources
